# VPU-CRM production — sao chép thành .env rồi điền. KHÔNG commit file .env (chứa mật khẩu).

# --- Bắt buộc ---
# Địa chỉ người dùng truy cập (HTTPS khi chạy thật; webhook Meta/Zalo/Telegram bắt buộc HTTPS)
SITE_URL=https://crm.example.edu.vn
# Mật khẩu database: chuỗi dài ngẫu nhiên, vd.  openssl rand -base64 30
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- HTTPS tự động (docker compose --profile https up -d) ---
# Tên miền (bản ghi DNS A/AAAA trỏ về máy chủ; mở cổng 80, 443)
DOMAIN=crm.example.edu.vn
# Email nhận thông báo chứng chỉ Let's Encrypt
ACME_EMAIL=it@example.edu.vn

# --- Tài khoản quản trị tạo ở lần cài đầu ---
ADMIN_USER=admin
# Để trống = tự sinh, xem bằng: docker compose exec app cat /state/admin-initial-password.txt
# (dù đặt hay tự sinh, lần đăng nhập đầu đều BẮT BUỘC đổi mật khẩu)
ADMIN_PASSWORD=

# --- Tuỳ chọn ---
# Cổng app khi KHÔNG dùng Caddy (đặt sau nginx/Apache có sẵn). Giữ 127.0.0.1 để không lộ ra ngoài.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TZ=Asia/Ho_Chi_Minh
DB_BUFFER_POOL=512M
VPU_IMAGE=vpu-crm:latest
VPU_VERSION=dev
