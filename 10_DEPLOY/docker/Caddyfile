# Reverse proxy HTTPS tự động (Let's Encrypt) cho VPU-CRM. Biến DOMAIN, ACME_EMAIL lấy từ .env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:80
}
